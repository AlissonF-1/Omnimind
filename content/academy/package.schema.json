{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OmniMind Academy package v1 and v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "pilot": {
      "type": "boolean"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 130
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true
          },
          "mastery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999999
              },
              "criterion": {
                "const": "verified-practice"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 350
              }
            },
            "required": [
              "version",
              "criterion",
              "description"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "prerequisites",
          "mastery"
        ]
      },
      "minItems": 1,
      "maxItems": 180
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/resource"
      },
      "minItems": 0,
      "maxItems": 512
    },
    "formations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "tech",
              "english"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 110
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 420
          },
          "art": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "lessons": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/lesson"
                  },
                  "minItems": 1,
                  "maxItems": 70
                }
              },
              "required": [
                "id",
                "title",
                "lessons"
              ]
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "description",
          "art",
          "chapters"
        ]
      },
      "minItems": 1,
      "maxItems": 10
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "caveat": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "id",
              "title",
              "date",
              "caveat"
            ]
          },
          "minItems": 0,
          "maxItems": 30
        },
        "vacancies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "sourceUrl": {
                "type": "string",
                "maxLength": 550,
                "pattern": "^https://[^\\s]+$"
              },
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "seniority": {
                "enum": [
                  "internship",
                  "entry",
                  "unspecified"
                ]
              },
              "collectedOn": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "minItems": 0,
                "maxItems": 32,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "title",
              "sourceUrl",
              "region",
              "seniority",
              "collectedOn",
              "requirements"
            ]
          },
          "minItems": 0,
          "maxItems": 250
        }
      },
      "required": [
        "description",
        "sources",
        "vacancies"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "pilot",
    "competencies",
    "resources",
    "formations",
    "market"
  ],
  "definitions": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "type": {
          "enum": [
            "image",
            "audio"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/academy/media/[a-z0-9-]+\\.(webp|png|jpg|mp3|ogg|wav)$"
        },
        "alt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250
        },
        "caption": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "enum": [
            "pt-BR",
            "en-US",
            "und"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "alt",
        "author",
        "license",
        "language",
        "version"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "input": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "expected": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "input",
        "expected"
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
