                "minLength": 1,
                "maxLength": 180
              },
              "example": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "audio": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "term",
              "translation",
